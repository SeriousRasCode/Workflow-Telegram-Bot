# Telegram Bot Token (obtain from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# GitHub Webhook Secret (configured in your GitHub repository/organization settings)
WEBHOOK_SECRET=your_github_webhook_secret_here

# Port for the webhook receiver HTTP server
PORT=3000

# Base URL where your bot is reachable publicly (e.g., https://your-bot-domain.com or https://abc.ngrok-free.app)
BASE_URL=http://localhost:3000

# Directory for persistent JSON settings storage
DATA_DIR=./data

# Default verbosity for commit messages ('detailed' or 'compact')
DEFAULT_VERBOSITY=detailed

# Operator-approved repositories by Telegram chat ID. An org/* rule permits all repositories in that organization.
CHAT_REPO_ALLOWLIST={"-100123456789":["my-org/api","my-org/*"]}

# Optional: repositories or organizations that any group admin may subscribe to.
PUBLIC_REPO_ALLOWLIST=public-org/*,another-org/website
